{
  "name": "waxwing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A serverless (static-only) webmail client for JMAP.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node scripts/demo.mjs",
    "e2e": "pnpm --filter @waxwing/e2e run e2e",
    "e2e:mount": "pnpm --filter @waxwing/e2e run e2e:mount",
    "e2e:deploy": "pnpm --filter @waxwing/e2e run e2e:deploy",
    "e2e:read": "pnpm --filter @waxwing/e2e run e2e:read",
    "e2e:shared": "pnpm --filter @waxwing/e2e run e2e:shared",
    "e2e:write": "pnpm --filter @waxwing/e2e run e2e:write",
    "e2e:demo": "pnpm --filter @waxwing/e2e run e2e:demo",
    "e2e:server": "pnpm --filter @waxwing/e2e run server:up",
    "e2e:server:main": "pnpm --filter @waxwing/e2e run server:up:main",
    "e2e:server:down": "pnpm --filter @waxwing/e2e run server:down",
    "seed:large": "node e2e/stalwart/seed-large.mjs",
    "seed:read": "node e2e/stalwart/seed-read.mjs",
    "webpush": "node scripts/webpush-check.mjs",
    "webpush:deliver": "node scripts/webpush-deliver.mjs",
    "webpush:status": "node scripts/webpush-status.mjs",
    "build": "pnpm -r --if-present build",
    "build:libs": "pnpm --filter @waxwing/jmap --filter @waxwing/mail-html --filter @waxwing/jscontact run build",
    "size": "pnpm --filter @waxwing/web build && size-limit",
    "check:dist": "node scripts/check-dist-contract.mjs",
    "verify": "pnpm build:libs && pnpm typecheck && pnpm lint && pnpm test && pnpm size && pnpm check:dist",
    "verify:e2e": "node scripts/verify-e2e.mjs",
    "verify:all": "pnpm verify && pnpm verify:e2e",
    "gate": "node scripts/ci.mjs",
    "gate:fast": "node scripts/ci.mjs --fast",
    "e2e:large": "pnpm --filter @waxwing/e2e run e2e:large"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@size-limit/file": "12.1.0",
    "@types/node": "24.13.2",
    "fake-indexeddb": "6.2.5",
    "size-limit": "12.1.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}

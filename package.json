{
  "name": "waxwing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A serverless (static-only) webmail client for JMAP.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @waxwing/e2e run e2e",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/node": "24.13.2",
    "fake-indexeddb": "6.2.5",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}

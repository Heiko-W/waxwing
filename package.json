{
  "name": "waxwing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A serverless (static-only) webmail client for JMAP.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node scripts/demo.mjs",
    "e2e": "pnpm --filter @waxwing/e2e run e2e",
    "e2e:demo": "pnpm --filter @waxwing/e2e run e2e:demo",
    "e2e:server": "pnpm --filter @waxwing/e2e run server:up",
    "e2e:server:main": "pnpm --filter @waxwing/e2e run server:up:main",
    "e2e:server:down": "pnpm --filter @waxwing/e2e run server:down",
    "build": "pnpm -r --if-present build",
    "size": "pnpm --filter @waxwing/web build && size-limit",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm size",
    "verify:e2e": "node scripts/verify-e2e.mjs",
    "verify:all": "pnpm verify && pnpm verify:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@size-limit/file": "12.1.0",
    "@types/node": "24.13.2",
    "fake-indexeddb": "6.2.5",
    "size-limit": "12.1.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}

{
  "name": "@waxwing/jmap",
  "version": "0.16.0",
  "private": true,
  "description": "Typed JMAP client (RFC 8620/8621 and extensions) \u2014 the JMAP core for Waxwing.",
  "keywords": [
    "jmap",
    "rfc8620",
    "rfc8621",
    "email",
    "mail",
    "client",
    "typescript"
  ],
  "license": "MIT",
  "author": "Heiko Wilke",
  "homepage": "https://github.com/Heiko-W/waxwing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heiko-W/waxwing.git",
    "directory": "packages/jmap"
  },
  "bugs": {
    "url": "https://github.com/Heiko-W/waxwing/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@waxwing/jscontact": "workspace:*",
    "tsup": "8.5.1"
  }

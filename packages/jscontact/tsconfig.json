{
  // `DOM` is here for the TESTS, not for the source. `TextEncoder`/`TextDecoder` are Web-platform
  // globals present in browsers, Node and workers alike, but TypeScript declares them only in
  // lib.dom — and the fold test uses them deliberately, as an independent oracle against this
  // package's own UTF-8 arithmetic. The source itself touches no DOM API: its one platform
  // dependency, `crypto.randomUUID`, is declared locally in from-vcard.ts so it stays visible.
  //
  // `types: ["node"]` is likewise test-only: `matrix.test.ts` reads README.md off disk, so the
  // documented support matrix is checked against actual behaviour instead of being maintained by
  // hand. The shipped code imports no Node built-in — `pnpm size` would notice if it did.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    // Needed by the DTS half of `tsup`, and by nothing else. The note here used to say "the base
    // config sets `baseUrl`" — tsconfig.base.json sets no such thing, and neither does this file,
    // so `tsc -p .` passes without this line (measured: exit 0). `tsup`'s d.ts build does not:
    // it supplies a `baseUrl` of its own and then fails with TS5101, "'baseUrl' is deprecated …
    // specify 'ignoreDeprecations': '6.0'". Removing the option therefore breaks `pnpm build:libs`
    // while `pnpm typecheck` stays green, which is the least helpful way to find out. It goes when
    // tsup stops setting `baseUrl`. packages/jmap and packages/mail-html carry the same line, and
    // those two additionally set `baseUrl` themselves.
    "ignoreDeprecations": "6.0"
  },
  "include": ["src"]
}

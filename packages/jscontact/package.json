{
  "name": "@waxwing/jscontact",
  "version": "0.14.0",
  "private": true,
  "description": "JSContact (RFC 9553) <-> vCard 4.0 (RFC 6350) conversion.",
  "keywords": [
    "jscontact",
    "vcard",
    "rfc9553",
    "rfc6350",
    "contacts",
    "typescript"
  ],
  "license": "MIT",
  "author": "Heiko Wilke",
  "homepage": "https://github.com/Heiko-W/waxwing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heiko-W/waxwing.git",
    "directory": "packages/jscontact"
  },
  "bugs": {
    "url": "https://github.com/Heiko-W/waxwing/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "8.5.1"
  }
}

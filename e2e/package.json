{
  "name": "@waxwing/e2e",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "description": "Playwright end-to-end suites and the Stalwart JMAP dev/test fixture.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "e2e": "playwright test",
    "e2e:mount": "playwright test -c playwright.mount.config.ts",
    "e2e:deploy": "playwright test -c playwright.deploy.config.ts",
    "e2e:read": "playwright test -c playwright.read.config.ts",
    "e2e:shared": "playwright test -c playwright.shared.config.ts",
    "e2e:write": "playwright test -c playwright.write.config.ts",
    "e2e:demo": "playwright test -c playwright.demo.config.ts",
    "server:up": "node stalwart/fixture.mjs up",
    "server:up:main": "node stalwart/fixture.mjs up main",
    "server:down": "node stalwart/fixture.mjs down",
    "server:provision": "node stalwart/fixture.mjs provision",
    "server:smoke": "node stalwart/fixture.mjs smoke",
    "typecheck": "tsc --noEmit",
    "e2e:large": "playwright test -c playwright.large.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.61.1"
  }
}

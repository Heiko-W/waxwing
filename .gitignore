# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Test / coverage artifacts
coverage/
test-results/
playwright-report/
blob-report/
.playwright/
# Screenshots/traces dropped in the repo root by the Playwright MCP browser.
.playwright-mcp/

# Vite
.vite/

# Stalwart dev/E2E fixture runtime data. The fixture (e2e/stalwart) persists to ephemeral
# Docker *named volumes* (wiped by `pnpm e2e:server:down`), so nothing normally lands here;
# these entries only matter if someone switches the compose file to host bind-mounts.
e2e/stalwart/data/
e2e/stalwart/.data/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env / secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
